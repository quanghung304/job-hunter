{
  "components" : {
    "schemas" : {
      "AcceptedResponse" : {
        "properties" : {
          "accepted" : {
            "type" : "boolean"
          }
        },
        "required" : [ "accepted" ],
        "type" : "object"
      },
      "CollectRunResponse" : {
        "properties" : {
          "collectStatus" : {
            "enum" : [ "SUCCESS", "PARTIAL", "FAILED" ],
            "type" : "string"
          },
          "error" : {
            "type" : [ "string", "null" ]
          },
          "fetched" : {
            "format" : "int32",
            "type" : "integer"
          },
          "newJobs" : {
            "format" : "int32",
            "type" : "integer"
          },
          "newRaw" : {
            "format" : "int32",
            "type" : "integer"
          },
          "runId" : {
            "format" : "int64",
            "type" : "integer"
          },
          "skippedInvalid" : {
            "format" : "int32",
            "type" : "integer"
          },
          "updatedJobs" : {
            "format" : "int32",
            "type" : "integer"
          },
          "warnings" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "collectStatus", "error", "fetched", "newJobs", "newRaw", "runId", "skippedInvalid", "updatedJobs", "warnings" ],
        "type" : "object"
      },
      "MetaResponse" : {
        "properties" : {
          "eligibilities" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "employmentTypes" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "profileId" : {
            "type" : "string"
          },
          "sources" : {
            "items" : {
              "$ref" : "#/components/schemas/SourceSummaryResponse"
            },
            "type" : "array"
          },
          "statuses" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "summaryLanguage" : {
            "enum" : [ "vi", "en" ],
            "type" : "string"
          }
        },
        "required" : [ "eligibilities", "employmentTypes", "profileId", "sources", "statuses", "summaryLanguage" ],
        "type" : "object"
      },
      "SourceSummaryResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "name" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "REST API of the Job Hunter backend; see docs/architecture/api-spec.md",
    "title" : "Job Hunter API",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/admin/collect/{sourceCode}" : {
      "post" : {
        "operationId" : "collect",
        "parameters" : [ {
          "in" : "path",
          "name" : "sourceCode",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CollectRunResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "admin-controller" ]
      }
    },
    "/api/admin/pipeline/run" : {
      "post" : {
        "operationId" : "runPipeline",
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AcceptedResponse"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "tags" : [ "admin-controller" ]
      }
    },
    "/api/meta" : {
      "get" : {
        "operationId" : "meta",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MetaResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "meta-controller" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
